{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?action=:path*" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/progress", "destination": "/api/progress" },
    { "source": "/api/coach", "destination": "/api/coach" },
    { "source": "/api/sentences", "destination": "/api/sentences" }
  ],
  "functions": {
    "api/sentences.js": { "maxDuration": 60 },
    "api/coach.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
