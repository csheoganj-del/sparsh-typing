{
  "version": 2,
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth.js?action=$1" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/progress", "dest": "/api/progress.js" },
    { "src": "/api/coach", "dest": "/api/coach.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
